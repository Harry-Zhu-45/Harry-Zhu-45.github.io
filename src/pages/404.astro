---
import MainGridLayout from '@layouts/MainGridLayout.astro';
import ButtonTag from '@components/control/ButtonTag.astro';
---

<MainGridLayout title="页面不存在">
	<div class="card-base flex flex-col items-center gap-3 p-10 text-center">
		<div class="text-7xl font-bold text-[var(--primary)]">404</div>
		<p class="text-50">这个地址没有对应的页面。</p>
		<ButtonTag href="/" label="返回首页">返回首页</ButtonTag>
	</div>
</MainGridLayout>
