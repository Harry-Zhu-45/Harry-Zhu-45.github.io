---
import I18nKey from '@i18n/i18nKey';
import { i18n } from '@i18n/translation';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import ButtonTag from '@components/control/ButtonTag.astro';
import { getTagList } from '@utils/content-utils';
import { getTagUrl } from '@utils/url-utils';

const tags = await getTagList();
---

<MainGridLayout title={i18n(I18nKey.tags)}>
	<div class="card-base flex flex-wrap gap-2 p-6">
		{tags.map((tag) => <ButtonTag href={getTagUrl(tag.name)} label={`查看“${tag.name}”标签下的文章`}>{tag.name}<span class="ml-2 opacity-60">{tag.count}</span></ButtonTag>)}
	</div>
</MainGridLayout>
