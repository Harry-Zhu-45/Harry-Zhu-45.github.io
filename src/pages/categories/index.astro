---
import I18nKey from '@i18n/i18nKey';
import { i18n } from '@i18n/translation';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import ButtonLink from '@components/control/ButtonLink.astro';
import { getCategoryList } from '@utils/content-utils';

const categories = await getCategoryList();
---

<MainGridLayout title={i18n(I18nKey.categories)}>
	<div class="card-base flex flex-col gap-1 p-4">
		{categories.map((category) => <ButtonLink url={category.url} badge={String(category.count)} label={`查看“${category.name}”分类下的文章`}>{category.name}</ButtonLink>)}
	</div>
</MainGridLayout>
