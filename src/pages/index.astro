---
import MainGridLayout from '@layouts/MainGridLayout.astro';
import Pagination from '@components/control/Pagination.astro';
import PostPage from '@components/PostPage.astro';
import { getSortedPosts } from '@utils/content-utils';
import { listingPage } from '@utils/listing-page';

const page = listingPage(await getSortedPosts(), '/');
---

<MainGridLayout>
	<PostPage page={page} />
	{page.lastPage > 1 && <Pagination page={page} basePath="/page/" firstPageUrl="/" class="mx-auto onload-animation" />}
</MainGridLayout>
