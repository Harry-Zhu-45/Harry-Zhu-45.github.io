---
import I18nKey from '@i18n/i18nKey';
import { i18n } from '@i18n/translation';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import Pagination from '@components/control/Pagination.astro';
import PostPage from '@components/PostPage.astro';
import { getSortedPosts } from '@utils/content-utils';
import { listingPage } from '@utils/listing-page';
import { dateParts } from '@utils/date';

const posts = await getSortedPosts();
const page = listingPage(posts, '/archives/');
const monthsByYear = new Map<string, Set<string>>();
for (const post of posts) {
	const { year, month } = dateParts(post.data.pubDate);
	if (!monthsByYear.has(year)) monthsByYear.set(year, new Set());
	monthsByYear.get(year)?.add(month);
}
const years = [...monthsByYear.entries()].map(([year, months]) => ({ year, months: [...months] }));
---

<MainGridLayout title={i18n(I18nKey.archive)}>
	<div class="card-base flex flex-col gap-3 p-4 mb-4" aria-label="按年月浏览文章">
		{years.map(({ year, months }) => <div class="flex flex-wrap items-center gap-2">
			<a class="btn-regular h-9 px-3 rounded-lg font-bold" href={`/archives/${year}/`}>{year}</a>
			{months.map((month) => <a class="btn-plain h-9 px-3 rounded-lg" href={`/archives/${year}/${month}/`}>{month} 月</a>)}
		</div>)}
	</div>
	<PostPage page={page} />
	{page.lastPage > 1 && <Pagination page={page} basePath="/archives/page/" firstPageUrl="/archives/" class="mx-auto onload-animation" />}
</MainGridLayout>
