---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { dateParts } from '../../../utils/date';

export async function getStaticPaths({ paginate }) {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	// Hexo: /archives/ 为第 1 页，/archives/page/2/ 起为后续页
	return paginate(posts, { pageSize: 10 }).filter((p) => p.params.page !== undefined);
}

const { page } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`归档 第 ${page.currentPage} 页 · HarryZ's Blog`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>归档</h1>
			<ul class="post-list">
				{
					page.data.map((post) => (
						<li>
							<a href={`/${dateParts(post.data.pubDate).year}/${dateParts(post.data.pubDate).month}/${dateParts(post.data.pubDate).day}/${post.id}/`}>
								<div class="post-title">{post.data.title}</div>
								<div class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</div>
							</a>
						</li>
					))
				}
			</ul>
			<nav class="pager">
				{page.url.prev && <a href={page.url.prev}>« 上一页</a>}
				<span>{page.currentPage} / {page.lastPage}</span>
				{page.url.next && <a href={page.url.next}>下一页 »</a>}
			</nav>
		</main>
		<Footer />
	</body>
</html>