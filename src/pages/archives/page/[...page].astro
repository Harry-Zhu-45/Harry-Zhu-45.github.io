---
import type { GetStaticPaths } from 'astro';
import I18nKey from '@i18n/i18nKey';
import { i18n } from '@i18n/translation';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import Pagination from '@components/control/Pagination.astro';
import PostPage from '@components/PostPage.astro';
import { PAGE_SIZE } from '@constants/constants';
import { getSortedPosts } from '@utils/content-utils';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getSortedPosts();
	return paginate(posts, { pageSize: PAGE_SIZE }).filter(({ params }) => params.page !== undefined);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainGridLayout title={`${i18n(I18nKey.archive)} · ${page.currentPage}`}>
	<PostPage page={page} />
	<Pagination page={page} basePath="/archives/page/" firstPageUrl="/archives/" class="mx-auto onload-animation" />
</MainGridLayout>
