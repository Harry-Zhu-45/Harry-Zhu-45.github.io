---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { dateParts } from '../../../utils/date';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	const months = new Map();
	for (const post of posts) {
		const { year, month } = dateParts(post.data.pubDate);
		const key = `${year}/${month}`;
		if (!months.has(key)) months.set(key, []);
		months.get(key).push(post);
	}
	return [...months.entries()].map(([key, monthPosts]) => {
		const [year, month] = key.split('/');
		return { params: { year, month }, props: { monthPosts } };
	});
}

const { monthPosts } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`归档 ${Astro.params.year}/${Astro.params.month} · HarryZ's Blog`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>归档</h1>
			<nav class="year-nav">
				<a href="/archives/">全部</a>
				<a href={`/archives/${Astro.params.year}/`} class="current">
					{Astro.params.year}
				</a>
			</nav>
			<ul class="post-list">
				{
					monthPosts.map((post) => (
						<li>
							<a href={`/${dateParts(post.data.pubDate).year}/${dateParts(post.data.pubDate).month}/${dateParts(post.data.pubDate).day}/${post.id}/`}>
								<div class="post-title">{post.data.title}</div>
								<div class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
