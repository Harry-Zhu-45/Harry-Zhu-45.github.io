---
import type { CollectionEntry } from 'astro:content';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import PostPage from '@components/PostPage.astro';
import { getSortedPosts } from '@utils/content-utils';
import { dateParts } from '@utils/date';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const months = new Map<string, CollectionEntry<'blog'>[]>();
	for (const post of posts) {
		const { year, month } = dateParts(post.data.pubDate);
		const key = `${year}/${month}`;
		if (!months.has(key)) months.set(key, []);
		months.get(key)?.push(post);
	}
	return [...months.entries()].map(([key, monthPosts]) => {
		const [year, month] = key.split('/');
		return { params: { year, month }, props: { year, month, monthPosts } };
	});
}

const { year, month, monthPosts } = Astro.props;
---

<MainGridLayout title={`归档 · ${year} 年 ${month} 月`}>
	<div class="card-base flex flex-wrap gap-2 p-4 mb-4">
		<a class="btn-regular h-9 px-3 rounded-lg" href="/archives/">全部归档</a>
		<a class="btn-regular h-9 px-3 rounded-lg" href={`/archives/${year}/`}>{year} 年</a>
	</div>
	<PostPage page={{ data: monthPosts }} />
</MainGridLayout>
